# Chép thành .env trong thư mục làm việc (nơi chạy `e2ea up` / `e2ea serve`).
# KHÔNG commit .env — nó chứa token.

# Repo cần agent sửa. URL GitLab → push nhánh + mở MR thật; đường dẫn trên đĩa → offline.
repo_url=https://git.example.com/nhom/ten-repo.git
# Token GitLab, vai trò Developer trở lên (push nhánh, tạo MR).
gitlab_token=

# Backlog (Nulab). Thiếu hai dòng space/project → ticket đọc/ghi trên đĩa (offline).
# Project nên để "Text formatting rule" = Markdown: comment của agent viết bằng Markdown.
backlog_space=xxx.backlog.com
backlog_project=PROJKEY
backlog_api_key=

# Tuỳ chọn: báo plan chờ duyệt / MR đã mở / cần người vào Google Chat (hoặc webhook tương tự).
google_chat_webhook=

# Tuỳ chọn: model và mức effort cho `claude -p`.
agent_model=opus
agent_effort=high
