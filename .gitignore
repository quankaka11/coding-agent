# --- Virtualenv ---
.venv/
venv/
venvs/

# --- Secret ---
.env
.env.*
!.env.example

# --- Dữ liệu vận hành của agent (mọi thứ dưới --dir) ---
repos/
work/
runs/
workspace/
# Bản cất .env của từng repo (giao diện web) — chứa token, không bao giờ commit.
.e2ea/
# Tracker/forge offline và bản cất hồ sơ trước khi "Sinh lại hồ sơ".
profiles/backlog/
profiles/*.bak
# Hồ sơ do `e2ea init/up` sinh cho từng repo — chứa đường dẫn venv của máy chạy, là dữ
# liệu vận hành chứ không phải code. Chỉ giữ hồ sơ mẫu.
profiles/*.yaml
!profiles/example.yaml

# --- Artefact test/coverage nếu chạy tay ngoài runs/ ---
.coverage
.coverage.*
coverage.json
htmlcov/
*-junit.xml

# --- IDE / tool cục bộ ---
.idea/
.vscode/
# Cấu hình Claude Code cá nhân (plugin, quyền) của người đang làm trên repo này.
.claude/
*.log
.DS_Store


